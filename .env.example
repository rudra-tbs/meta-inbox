# WhatsApp / Meta
WHATSAPP_APP_SECRET=          # App Secret from Meta App Dashboard → Settings → Basic (HMAC for inbound webhook)
WHATSAPP_VERIFY_TOKEN=        # Any string you choose; used to verify the webhook subscription
INSTAGRAM_VERIFY_TOKEN=       # Optional separate verify token for the IG subscription (same value as WA also works)

# Long-lived Meta tokens — keyed by per-brand suffix. Tokens NEVER live in
# the database. Pattern:
#   WHATSAPP_TOKEN_<SUFFIX>    Cloud API system-user token for the brand's WhatsApp number
#   INSTAGRAM_TOKEN_<SUFFIX>   Page access token covering the brand's IG Business Account
# <SUFFIX> = brandToEnvKey(display_name) — first letter of each word for
# multi-word names, full uppercased for single-word names, max 10 chars.
# Examples:
#   'The Bride Side'             → TBS
#   'Revaah Decor'               → RD
#   'Rahul Saharan Photography'  → RSP
#   'The Wedding Minimalist'     → TWM
#   'Auramist'                   → AURAMIST
# The Channels admin tab shows the exact suffix for any brand you select.
WHATSAPP_TOKEN_TBS=
INSTAGRAM_TOKEN_TBS=
WHATSAPP_TOKEN_RD=
INSTAGRAM_TOKEN_RD=
# Add more brands as you onboard them, e.g.:
# WHATSAPP_TOKEN_RSP=
# INSTAGRAM_TOKEN_RSP=

# LLM (Groq — OpenAI-compatible chat-completions)
GROQ_API_KEY=                 # From console.groq.com → API Keys
GROQ_MODEL=                   # Defaults to llama-3.3-70b-versatile. Override e.g. llama-3.1-8b-instant
GROQ_FALLBACK_MODELS=         # Optional comma-separated list tried on 429/5xx

# Supabase
NEXT_PUBLIC_SUPABASE_URL=     # Project URL from Supabase → Connect → API
NEXT_PUBLIC_SUPABASE_ANON_KEY= # Anon key from Supabase → Settings → API
SUPABASE_SERVICE_ROLE_KEY=    # Service role key (server-side only, never expose to client)

# CRM MySQL (thebrideside)
CRM_MYSQL_HOST=               # MySQL host / IP
CRM_MYSQL_PORT=3306           # Default 3306
CRM_MYSQL_USER=               # MySQL username
CRM_MYSQL_PASSWORD=           # MySQL password
CRM_MYSQL_DATABASE=thebrideside

# CRM pipeline mapping (any one path is enough)
# CRM_PIPELINE_<BRAND>_ID=
# CRM_PIPELINE_<BRAND>_INITIAL_STAGE_ID=
CRM_DEFAULT_INITIAL_STAGE_ID=

# Hardening
STRICT_BRAND_PROMPT=          # Set to "1" in prod to refuse the generic fallback prompt for brands missing a brand_contexts row
WEBHOOK_RATE_WINDOW_MS=       # Default 60000 (per-sender inbound rate-limit window)
WEBHOOK_RATE_MAX=             # Default 30 (max messages per sender per window)

# Observability (Sentry)
SENTRY_DSN=                   # Server / edge runtime DSN from sentry.io → project settings
NEXT_PUBLIC_SENTRY_DSN=       # Same DSN exposed to the browser bundle (Sentry Next.js convention)

# App
NEXT_PUBLIC_APP_URL=          # e.g. https://desk.acceltancy.in or http://localhost:3000
